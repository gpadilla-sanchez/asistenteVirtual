{
  "name": "plataforma-asistente-seguros",
  "version": "1.0.0",
  "description": "Plataforma multi-agente de recordatorios de pago de pólizas por WhatsApp",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "simulador": "node dist/simulador/index.js",
    "inicializar": "node dist/cli/inicializar.js",
    "secretos": "node dist/cli/secretos.js",
    "agente": "node dist/cli/agente.js",
    "validar": "node dist/cli/validar.js",
    "probar-portal": "node dist/cli/probar-portal.js",
    "revision": "node dist/cli/revision.js",
    "crear-plantillas": "node dist/cli/crear-plantillas.js",
    "respaldo": "node dist/cli/respaldo.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "playwright-core": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
